# Copy to .env and adjust. docker compose reads .env automatically.

# SQLite file inside the container (mounted volume). Any SQLAlchemy URL works.
DATABASE_URL=sqlite:////srv/data/callback_inspector.db

# Default / maximum per-delivery HTTP timeout when the client does not pass one.
DEFAULT_TIMEOUT_SECONDS=10
MAX_TIMEOUT_SECONDS=60

# Response/request bodies longer than this are truncated before storing.
MAX_STORED_BODY_CHARS=65536

# Pre-filled destination in the web form (the mock receiver from docker-compose).
DEMO_DESTINATION_URL=http://receiver:8001/callback

# --- Security -----------------------------------------------------------------------------------
# Extra header names to redact from stored evidence (comma-separated, case-insensitive).
# They EXTEND the built-in list, which is always active even if this is empty:
#   Authorization, Proxy-Authorization, Cookie, Set-Cookie, X-API-Key, X-Auth-Token,
#   X-Access-Token, X-Internal-Token
# Sensitive headers are still sent to the destination unchanged — only the evidence is redacted.
SENSITIVE_HEADERS=

# Optional HMAC-SHA256 signing of outbound callbacks:
#   X-Callback-Timestamp: <UTC unix seconds>
#   X-Callback-Signature: sha256=<hex(HMAC_SHA256(secret, timestamp + "." + raw_body))>
# The secret lives only in the runtime environment; it is never stored, returned or logged.
# Startup fails (SIGNING_CONFIGURATION_ERROR) if signing is enabled with an empty secret.
CALLBACK_SIGNING_ENABLED=false
CALLBACK_SIGNING_SECRET=
CALLBACK_SIGNATURE_HEADER=X-Callback-Signature
CALLBACK_TIMESTAMP_HEADER=X-Callback-Timestamp

# Mock receiver only (demo): verify signatures with this secret; empty = no verification.
RECEIVER_SIGNATURE_SECRET=
